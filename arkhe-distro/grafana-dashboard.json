{
  "dashboard": {
    "title": "ARKHE Cathedral - Visão Geral",
    "panels": [
      {
        "title": "Requisições por Substrato",
        "targets": [
          {
            "expr": "rate(arkhe_requests_total[5m])",
            "legendFormat": "{{substrate}} - {{status}}"
          }
        ]
      },
      {
        "title": "Latência p99 (Hermes ZK)",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(arkhe_zk_proving_seconds_bucket[5m]))",
            "legendFormat": "{{circuit}}"
          }
        ]
      },
      {
        "title": "Alertas do Glasswing Sentinel",
        "targets": [
          {
            "expr": "rate(arkhe_vulnerabilities_found{severity=~\"CRITICAL|HIGH\"}[5m])"
          }
        ]
      }
    ]
  }
}
